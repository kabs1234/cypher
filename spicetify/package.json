{
  "name": "cypher-spicetify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch-types.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --format=iife --target=chrome120 --outfile=dist/cypher.js",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
